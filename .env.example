# 真实值通过环境安全配置注入；不要提交到 Git。
KOC_DB=var/koc.sqlite3
KOC_REPORT_DIR=var/reports
XHS_API_BASE_URL=http://127.0.0.1:5556
XHS_API_TOKEN=
# 只有核验上游 TLS 和只读访问后才能开启；默认关闭。
XHS_READONLY_REVIEWED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：私有凭证文件，设置后优先于 FEISHU_APP_SECRET；不提交真实文件。
FEISHU_APP_SECRET_FILE=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_NOTES_ID=

# 使用加密共享状态时启用；本地演示会自动隔离。
KOC_REMOTE_STATE=local
KOC_GITHUB_REPO=
KOC_STATE_KEY_FILE=
KOC_UPSTREAM_ROOT=/workspace/dependencies/XHS-Downloader
KOC_TESSDATA_DIR=/workspace/dependencies/tessdata

